# Cloudflare Pages security headers, applied to every response.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# The CSP is built from the origins this landing actually uses:
#   - Google Fonts       fonts.googleapis.com (CSS) + fonts.gstatic.com (WOFF)
#   - Cloudinary          res.cloudinary.com (product images)
#   - Backend admin API   horno-product-admin.onrender.com (catalog fetch)
# `style-src`/`script-src` keep 'unsafe-inline' because Astro emits inline
# styles and the GSAP/Lenis bootstrap runs inline; tightening to hashes/nonces
# is tracked separately and is not required to close the header gaps.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://res.cloudinary.com; connect-src 'self' https://horno-product-admin.onrender.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
