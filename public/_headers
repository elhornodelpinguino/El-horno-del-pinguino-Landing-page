# Cloudflare Pages security headers, applied to every response.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# The CSP is built from the origins this landing actually uses:
#   - Fonts               self-hosted under /fonts (Fraunces + Poppins, OFL)
#   - Cloudinary          res.cloudinary.com (product images)
#   - Backend admin API   horno-product-admin.onrender.com (catalog fetch)
# `style-src`/`script-src` keep 'unsafe-inline' because Astro emits inline
# styles and the GSAP/Lenis bootstrap runs inline; tightening to hashes/nonces
# is tracked separately and is not required to close the header gaps.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://res.cloudinary.com; connect-src 'self' https://horno-product-admin.onrender.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Font files are not content-hashed, so cache them for a year and rename the
# file when a font changes.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
