---
import { SITE, whatsappLink } from "~/lib/config";
import { ORDER_CHOICES, DEFAULT_ORDER, buildOrderMessage } from "~/scripts/order-sentence.js";

// The close is where the order gets written. Three native selects sit inside
// one sentence; the WhatsApp link sends that sentence. Without JS the link
// still carries the default order, and the selects stay usable.
const blanks = [
  { key: "what", label: "Qué quieres" },
  { key: "who", label: "Para cuántos" },
  { key: "when", label: "Para cuándo" },
] as const;
const defaultLink = whatsappLink(buildOrderMessage(SITE.name, DEFAULT_ORDER));

const blankSelect = (key: (typeof blanks)[number]["key"]) => ({
  options: ORDER_CHOICES[key],
  selected: DEFAULT_ORDER[key],
  label: blanks.find((blank) => blank.key === key)!.label,
});
const what = blankSelect("what");
const photo = ORDER_CHOICES.what.find((option) => option.value === DEFAULT_ORDER.what)!.photo;
const who = blankSelect("who");
const when = blankSelect("when");
---

<section class="order-close" data-order-close aria-labelledby="order-close-heading">
  <div class="order-close-media">
    <figure class="order-close-photo" data-order-photo>
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        style={`object-position: ${photo.position}`}
        data-order-photo-img
        loading="lazy"
        decoding="async"
      />
    </figure>
    <!-- The penguin takes the order: it nods and says so on every change. -->
    <div class="order-close-penguin" data-order-penguin aria-hidden="true">
      <span class="order-close-bubble">¡Anotado!</span>
    </div>
  </div>

  <div class="order-close-body">
    <h2 id="order-close-heading" data-finalcta-anim="heading" class="display-section order-close-heading">¿Se te antojó?</h2>

    <form class="order-close-form" data-order-form data-site-name={SITE.name} onsubmit="return false">
      <p class="order-sentence" data-order-sentence>
        Quiero{" "}
        <label class="sr-only" for="order-what">{what.label}</label>
        <select id="order-what" class="order-blank" data-blank="what">
          {what.options.map((option) => <option value={option.value} selected={option.value === what.selected}>{option.label}</option>)}
        </select>{" "}
        <span class="order-slot">
          <label class="sr-only" for="order-who">{who.label}</label>
          <select id="order-who" class="order-blank" data-blank="who">
            {who.options.map((option) => <option value={option.value} selected={option.value === who.selected}>{option.label}</option>)}
          </select>,</span>{" "}
        <span class="order-slot">
          <label class="sr-only" for="order-when">{when.label}</label>
          <select id="order-when" class="order-blank" data-blank="when">
            {when.options.map((option) => <option value={option.value} selected={option.value === when.selected}>{option.label}</option>)}
          </select>.</span>
      </p>
      <p class="order-close-hint">Cambia las palabras subrayadas y envíanos tu pedido.</p>

      <div data-finalcta-anim="actions" class="order-close-actions">
        <a
          href={defaultLink}
          target="_blank"
          rel="noopener"
          data-order-link
          data-phone={SITE.whatsapp}
          data-magnetic
          class="order-close-cta"
        >
          <svg viewBox="0 0 32 32" class="h-7 w-7 shrink-0" aria-hidden="true">
            <circle cx="16" cy="16" r="15" fill="#25D366" />
            <path fill="#fff" d="M16.04 7.15a8.64 8.64 0 0 0-7.38 13.12l-.93 3.43 3.51-.92a8.65 8.65 0 1 0 4.8-15.63Zm0 15.77a7.1 7.1 0 0 1-3.62-.99l-.26-.15-2.08.54.56-2.02-.17-.27a7.11 7.11 0 1 1 5.57 2.89Zm3.9-5.32c-.21-.11-1.27-.63-1.47-.7-.2-.07-.34-.11-.49.11-.14.21-.56.7-.69.84-.13.14-.25.16-.46.05-.21-.11-.9-.33-1.72-1.06-.64-.57-1.07-1.27-1.2-1.49-.13-.21-.01-.33.1-.44.1-.1.21-.25.32-.38.11-.13.14-.21.21-.36.07-.14.04-.27-.02-.38-.05-.11-.49-1.18-.67-1.62-.18-.43-.36-.37-.49-.38h-.42c-.14 0-.38.05-.58.27-.2.21-.76.74-.76 1.81s.78 2.1.89 2.25c.11.14 1.53 2.34 3.71 3.28.52.22.92.36 1.23.46.52.17.99.14 1.36.09.41-.06 1.27-.52 1.45-1.02.18-.5.18-.94.13-1.02-.05-.09-.2-.14-.41-.25Z" />
          </svg>
          <span class="sm:hidden">Pedir por WhatsApp</span>
          <span class="hidden sm:inline">Enviar pedido por WhatsApp</span>
        </a>
        <p class="order-close-facts">Te respondemos el mismo día · Entregamos dentro de Loja</p>
      </div>
    </form>
  </div>
</section>

<script>
  import "~/scripts/final-cta-order.js";
</script>
