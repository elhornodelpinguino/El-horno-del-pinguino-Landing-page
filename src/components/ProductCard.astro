---
import type { Product } from "~/lib/api";
import { formatPrice } from "~/lib/api";
import { cloudinaryImage } from "~/lib/cloudinary";
import { whatsappLink } from "~/lib/config";

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Cards render between ~290 and ~420 CSS px wide (4:5 box), so a handful of
// widths covers every viewport and density. The raw upload is 3024x4032.
const PHOTO_WIDTHS = [360, 480, 640, 800, 960];
const PHOTO_SIZES =
  "(min-width: 1536px) 419px, (min-width: 1280px) 376px, (min-width: 1024px) calc((100vw - 152px) / 3), (min-width: 640px) calc((100vw - 92px) / 2), calc(100vw - 40px)";
const photo = product.imageUrl ? cloudinaryImage(product.imageUrl, { widths: PHOTO_WIDTHS, defaultWidth: 640 }) : null;

const orderLink = whatsappLink(
  `Hola! Quiero pedir información sobre: ${product.name} (${formatPrice(product.price)}). ¿Está disponible?`,
);
---

<article class="product-card">
  <div class="product-card-media">
    {
      photo ? (
        <img
          src={photo.src}
          srcset={photo.srcset}
          sizes={photo.srcset ? PHOTO_SIZES : undefined}
          alt={product.name}
          width={800}
          height={1000}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="h-full w-full bg-surface-alt" aria-hidden="true"></div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="product-card-title font-display text-xl leading-snug text-ink-role-brand">
      {product.name}
    </h3>

    {
      product.description && (
        <p class="product-card-description">
          <span>{product.description}</span>
        </p>
      )
    }

    <div class="mt-auto flex items-center justify-between gap-3 pt-4">
      <span class="text-2xl font-bold text-ink-role-accent">
        {formatPrice(product.price)}
      </span>
      <a
        href={orderLink}
        target="_blank"
        rel="noopener"
        data-whatsapp-context="consumer"
        class="inline-flex items-center gap-2 rounded-full bg-horno-magenta px-4 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-horno-magentaDeep"
      >
        Pedir
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</article>
