---
import { SITE, whatsappLink } from "~/lib/config";

// B2B is an outbound channel: businesses are visited and pitched, they do not
// arrive here searching. This block only signals that volume orders exist and
// hands the conversation to WhatsApp.
const quoteLink = whatsappLink(
  `¡Hola ${SITE.name}! Represento a un negocio y quiero cotizar pedidos por volumen en Loja.`,
);

// The quote link is a standalone secondary action beside the primary button,
// not a link inside a sentence, so WCAG 2.5.8's inline exception does not
// cover it and it carries a full tap height.
---

<section id="negocios" class="relative overflow-hidden py-14 sm:py-20">
  <div class="section relative z-10">
    <div class="flex flex-col items-center gap-6 rounded-3xl border border-horno-magentaDeep/10 bg-white/70 px-7 py-10 text-center shadow-card backdrop-blur sm:flex-row sm:justify-between sm:text-left">
      <div class="max-w-xl">
        <h2 class="font-display text-2xl leading-tight text-horno-magentaDeep sm:text-3xl">
          ¿Tienes un negocio, colegio o club?
        </h2>
        <p class="mt-3 leading-relaxed text-horno-magentaDeep/75">
          También trabajamos pedidos por volumen en Loja, con porción consistente y entrega
          coordinada.
        </p>
      </div>

      <div class="flex flex-shrink-0 flex-col items-center gap-3 sm:items-end">
        <a href="/negocios" class="btn-primary">
          Ver para negocios
        </a>
        <a href={quoteLink} target="_blank" rel="noopener" data-whatsapp-context="business-intro" class="inline-flex min-h-[44px] items-center text-sm font-medium text-horno-magentaDeep/70 underline-offset-4 hover:underline">
          O pide cotización directo por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
