---
import { SITE, whatsappLink } from "~/lib/config";

// B2B is an outbound channel: businesses are visited and pitched, they do not
// arrive here searching. This block only signals that volume orders exist and
// hands the conversation to WhatsApp.
const quoteLink = whatsappLink(
  `¡Hola, ${SITE.name}! Represento a un negocio y quiero cotizar pedidos por volumen en Loja.`,
);

// The quote link is a standalone secondary action beside the primary button,
// not a link inside a sentence, so WCAG 2.5.8's inline exception does not
// cover it and it carries a full tap height.
---

<section id="negocios" class="on-brand business-bridge relative overflow-hidden py-20 sm:py-28">
  <div class="section relative z-10 grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
    <div class="text-center lg:text-left">
      <span class="business-bridge-tag">Pedidos por volumen</span>
      <h2 class="display-section mt-5 text-ink-role-brand">
        ¿Tienes un negocio, colegio o club?
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-role lg:mx-0">
        También horneamos por volumen en Loja: cada porción del mismo tamaño y entregas
        coordinadas a tu horario.
      </p>

      <div class="mt-9 flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start">
        <a href="/negocios" class="business-bridge-cta">
          Ver para negocios
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href={quoteLink} target="_blank" rel="noopener" data-whatsapp-context="business-intro" class="inline-flex min-h-[44px] items-center font-semibold text-ink-role underline decoration-2 underline-offset-[0.4em] hover:text-ink-role-brand">
          O cotiza directamente por WhatsApp
        </a>
      </div>
    </div>

    <!-- The three customers, each penguin dressed for one of them. -->
    <div class="business-bridge-crew" aria-hidden="true">
      <div class="business-bridge-penguin business-bridge-penguin--coffee"></div>
      <div class="business-bridge-penguin business-bridge-penguin--business"></div>
      <div class="business-bridge-penguin business-bridge-penguin--student"></div>
    </div>
  </div>
</section>
