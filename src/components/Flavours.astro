---
import { SITE, whatsappLink } from "~/lib/config";

const flavours = [
  {
    title: "Frutos rojos",
    copy: "Ácido, fresco y nada empalagoso.",
    tone: "bg-horno-magenta",
  },
  {
    title: "Maracuyá",
    copy: "El favorito. Dulce arriba, ácido abajo.",
    tone: "bg-horno-orange",
  },
  {
    title: "Oreo",
    copy: "Crema, galleta y más galleta.",
    tone: "bg-horno-magentaDeep",
  },
];
---

<section id="sabores" class="relative overflow-hidden py-16 sm:py-24">
  <div class="section relative z-10">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Sabores</span>
      <h2 class="mt-2 text-3xl leading-tight text-horno-magentaDeep sm:text-4xl">
        Tres que nunca fallan
      </h2>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {flavours.map((item) => (
        <article class="overflow-hidden rounded-3xl border border-horno-magentaDeep/10 bg-white/70 shadow-card backdrop-blur">
          <div class:list={["h-2 w-full", item.tone]} aria-hidden="true"></div>
          <div class="p-7">
            <h3 class="font-display text-xl text-horno-magentaDeep">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-horno-ink/70">{item.copy}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-horno-magentaDeep/75">
      ¿Buscas otro sabor?{" "}
      <a
        href={whatsappLink(`¡Hola ${SITE.name}! ¿Tienen otros sabores además de frutos rojos, maracuyá y Oreo?`)}
        target="_blank"
        rel="noopener"
        class="font-semibold text-horno-magenta underline underline-offset-4 transition hover:text-horno-magentaDeep"
      >
        Escríbenos y lo vemos
      </a>.
    </p>
  </div>
</section>
