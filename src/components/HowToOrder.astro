---
import { SITE, whatsappLink } from "~/lib/config";

const steps = [
  { number: "01", title: "Cuéntanos qué se te antoja y para cuántos", penguinClass: "penguin-step-1" },
  { number: "02", title: "Te ayudamos a elegir sabor y tamaño", penguinClass: "penguin-step-2" },
  { number: "03", title: "Pagas y coordinamos la entrega en Loja", penguinClass: "penguin-step-3" },
];
---

<section id="como-pedir" class="order-section relative overflow-hidden py-20 sm:py-28">
  <div class="section relative z-10">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <span data-order-anim="eyebrow" class="eyebrow">Así de fácil</span>
      <h2 data-order-anim="heading" class="display-section mt-2">
        Tres mensajes y listo
      </h2>
    </div>

    <div class="relative grid gap-6 md:mt-20 md:grid-cols-3 lg:gap-10">
      <div class="order-route" aria-hidden="true">
        <span data-order-anim="route" class="order-route-fill"></span>
        <span data-order-anim="stop" class="order-route-stop"></span>
        <span data-order-anim="stop" class="order-route-stop"></span>
        <span data-order-anim="stop" class="order-route-stop"></span>
      </div>
      {steps.map((step, index) => (
        <article data-order-anim="step" class="order-step-card" style={`--i: ${index}`}>
          <div data-order-anim="sprite" class:list={["penguin-step", step.penguinClass]} aria-hidden="true"></div>
          <span class="order-step-number">{step.number}</span>
          <h3>{step.title}</h3>
        </article>
      ))}
    </div>

    <div data-order-anim="cta" class="mt-10 text-center">
      <a href={whatsappLink(`¡Hola, ${SITE.name}! Quiero hacer un pedido. ¿Me pasan sabores y precios?`)} target="_blank" rel="noopener" data-whatsapp-context="consumer" class="btn-primary">
        Escríbenos por WhatsApp
      </a>
    </div>
  </div>
</section>

<script>
  import "~/scripts/order-animation.js";
</script>
