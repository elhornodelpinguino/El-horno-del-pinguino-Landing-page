---
import SiteHeader from "~/components/SiteHeader.astro";
import "~/styles/global.css";
import { ANALYTICS_CONFIG, SITE } from "~/lib/config";
import { serializeJsonLd } from "~/lib/json-ld";
import { buildHeadSeo } from "~/lib/seo";
import { MEASURED_ROUTES, normalizeRoute } from "~/scripts/analytics.js";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  /** Keep the page out of search results (no canonical, no og:url). */
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title = `${SITE.name} — Postres artesanales hechos para sorprender`,
  description = SITE.description,
  ogImage = "/og-image.png",
  canonicalUrl = Astro.url.href,
  noindex = false,
  jsonLd,
} = Astro.props;

const seo = buildHeadSeo({ canonicalUrl, noindex, site: Astro.site });
const ogImg = new URL(ogImage, Astro.site).href;
const analyticsEndpoint = ANALYTICS_CONFIG?.endpoint;
const analyticsRoute = normalizeRoute(Astro.url.pathname);
const shouldLoadAnalytics = analyticsEndpoint !== undefined && analyticsRoute !== null && MEASURED_ROUTES.includes(analyticsRoute);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <!-- Theme before first paint (no flash). Mirrors resolveTheme() in
         src/scripts/theme.js: a stored choice wins, otherwise the system. -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem("horno-theme"); } catch (e) {}
        var dark = stored === "dark" || (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {seo.robots && <meta name="robots" content={seo.robots} />}
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {seo.ogUrl && <meta property="og:url" content={seo.ogUrl} />}
    <meta property="og:image" content={ogImg} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={ogImg} />
    <meta name="theme-color" content="#a81452" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Hero fonts: the display face (H1) and the body weight (copy). The other
         weights are discovered from the CSS and are not on the first-paint path. -->
    <link rel="preload" href="/fonts/fraunces-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-latin-500.woff2" as="font" type="font/woff2" crossorigin />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
      )
    }
    {shouldLoadAnalytics && <meta name="analytics-endpoint" content={analyticsEndpoint} />}
    {
      shouldLoadAnalytics && (
        <script>
          import { initializeAnalytics } from "~/scripts/analytics.js";
          const endpoint = document.querySelector('meta[name="analytics-endpoint"]')?.getAttribute("content");
          if (endpoint) initializeAnalytics({ endpoint });
        </script>
      )
    }
  </head>
  <body>
    <SiteHeader />
    <slot />
    <script>
      import "~/scripts/smooth-scroll.js";
      import "~/scripts/magnetic-cta.js";
    </script>
  </body>
</html>
