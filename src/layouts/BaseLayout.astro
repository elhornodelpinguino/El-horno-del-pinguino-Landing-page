---
import "~/styles/global.css";
import { ANALYTICS_CONFIG, SITE } from "~/lib/config";
import { serializeJsonLd } from "~/lib/json-ld";
import { MEASURED_ROUTES, normalizeRoute } from "~/scripts/analytics.js";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title = `${SITE.name} — Postres artesanales hechos para sorprender`,
  description = SITE.description,
  ogImage = "/og-image.png",
  canonicalUrl = Astro.url.href,
  jsonLd,
} = Astro.props;

const ogUrl = new URL(canonicalUrl, Astro.site).href;
const ogImg = new URL(ogImage, Astro.site).href;
const analyticsEndpoint = ANALYTICS_CONFIG?.endpoint;
const analyticsRoute = normalizeRoute(Astro.url.pathname);
const shouldLoadAnalytics = analyticsEndpoint !== undefined && analyticsRoute !== null && MEASURED_ROUTES.includes(analyticsRoute);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImg} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={ogImg} />
    <meta name="theme-color" content="#a81452" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600..700&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
      )
    }
    {shouldLoadAnalytics && <meta name="analytics-endpoint" content={analyticsEndpoint} />}
    {
      shouldLoadAnalytics && (
        <script>
          import { initializeAnalytics } from "~/scripts/analytics.js";
          const endpoint = document.querySelector('meta[name="analytics-endpoint"]')?.getAttribute("content");
          if (endpoint) initializeAnalytics({ endpoint });
        </script>
      )
    }
  </head>
  <body>
    <slot />
    <script>
      import "~/scripts/smooth-scroll.js";
      import "~/scripts/magnetic-cta.js";
    </script>
  </body>
</html>
