---
// E2E test fixture ONLY — not linked from any real page.
//
// Why this exists: ProductGrid's product count comes from an SSR fetch in
// src/pages/index.astro (getProducts() / loadFallback()), which runs on the
// server before the browser ever sees a request. Playwright's page.route()
// only intercepts *browser* network calls, so it cannot control the SSR
// product count on the real "/" route. This fixture renders the same
// ProductGrid component (with the same catalog-animation.js wiring) against
// a deterministic, path-param-controlled product count so the
// ScrollTrigger.batch() reveal contract can be tested for N=0/1/6 without
// depending on the live product-admin backend.
//
// Static-build access guard: this route is prerendered at BUILD time (this
// project's static output has no server runtime), so the only gate
// available is which paths `getStaticPaths()` emits. `fixturePathsFor()`
// (see `~/utils/fixture-gate`) reads `ENABLE_E2E_FIXTURES`, which is only
// ever set to `"true"` by `playwright.config.ts`'s `webServer.env` at BUILD
// time. When unset (the production build Cloudflare Pages runs), this
// function returns `[]` and the build emits NO paths under this route —
// requests to it 404 in production, the same guarantee the previous
// runtime check provided.
import { fixturePathsFor } from "~/utils/fixture-gate";

export function getStaticPaths() {
  return fixturePathsFor(process.env.ENABLE_E2E_FIXTURES);
}

import BaseLayout from "~/layouts/BaseLayout.astro";
import ProductGrid from "~/components/ProductGrid.astro";
import type { Product } from "~/lib/api";

const { count: countParam } = Astro.params;
const parsedCount = Number.parseInt(countParam ?? "0", 10);
const count = Number.isFinite(parsedCount) ? Math.max(0, parsedCount) : 0;

function makeFixtureProduct(i: number): Product {
  return {
    id: `00000000-0000-4000-8000-${String(i).padStart(12, "0")}`,
    name: `Producto de prueba ${i}`,
    description: "Producto sintético usado solo por tests E2E.",
    price: 999,
    currency: "USD",
    imageUrl: "",
  };
}

const products: Product[] = Array.from({ length: count }, (_, i) => makeFixtureProduct(i + 1));
---

<BaseLayout title="QA fixture — catalog batch">
  <ProductGrid products={products} />
</BaseLayout>
