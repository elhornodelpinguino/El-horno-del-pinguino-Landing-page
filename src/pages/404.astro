---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { SITE, whatsappLink } from "~/lib/config";

// Backend-independent on purpose: a 404 must render even if the API is asleep.

const title = `Página no encontrada — ${SITE.name}`;
const description = "Esta página no existe, pero el horno sigue encendido. Volvé al inicio o pedí por WhatsApp.";

const homeMessage = `¡Hola ${SITE.name}! Llegué a una página que no existe, pero quiero pedir postres.`;
---

<BaseLayout title={title} description={description} canonicalUrl="https://elhornodelpinguino.com/404">
  <main class="flex min-h-screen items-center justify-center bg-horno-gradient-soft px-6 py-24 text-center">
    <div class="max-w-xl">
      <img
        src="/penguin-chef-oven-transparent.png"
        alt="El pingüino chef mirando su horno"
        width="220"
        height="220"
        class="mx-auto h-40 w-40 object-contain sm:h-52 sm:w-52"
        loading="eager"
      />
      <p class="mt-8 text-sm font-semibold uppercase tracking-[0.3em] text-horno-orangeInk">Error 404</p>
      <h1 class="mt-3 font-display text-4xl leading-tight text-horno-magentaDeep sm:text-5xl">
        Se nos quemó esta página.
      </h1>
      <p class="mt-5 leading-relaxed text-horno-magentaDeep/75">
        La URL que buscás no existe o cambió. Pero el horno sigue encendido y los postres siguen listos.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/" class="btn-primary">Volver al inicio</a>
        <a href={whatsappLink(homeMessage)} target="_blank" rel="noopener" class="btn-secondary">
          Pedir por WhatsApp
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
