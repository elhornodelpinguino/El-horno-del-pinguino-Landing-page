---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Marquee from "~/components/Marquee.astro";
import ProductGrid from "~/components/ProductGrid.astro";
import Statement from "~/components/Statement.astro";
import FlavourShowcase from "~/components/FlavourShowcase.astro";
import BusinessBridge from "~/components/BusinessBridge.astro";
import HowToOrder from "~/components/HowToOrder.astro";

import Trust from "~/components/Trust.astro";
import FAQ from "~/components/FAQ.astro";
import AnnouncementBanner from "~/components/AnnouncementBanner.astro";
import FinalCTA from "~/components/FinalCTA.astro";
import Contact from "~/components/Contact.astro";
import StickyWhatsApp from "~/components/StickyWhatsApp.astro";
import ErrorBoundary from "~/components/ErrorBoundary.astro";
import { getProducts, loadFallback } from "~/lib/api";
import type { Product } from "~/lib/api";
import { SITE } from "~/lib/config";
import { loadSiteContent, resolveFaqs } from "~/lib/site-content";
import { localBusinessSchema } from "~/lib/schema";

// Must run before anything reads SITE: applies the admin's site settings.
// Never throws — a failed endpoint falls back to today's values.
const { content } = await loadSiteContent();
const faqs = resolveFaqs(content.faqs);

let products: Product[] = [];
let hasProductsError = false;

try {
  products = await getProducts();
} catch (err) {
  console.error("Error fetching products:", err);
  try {
    products = loadFallback();
  } catch (fbErr) {
    console.error("Fallback also failed:", fbErr);
  }
  hasProductsError = products.length === 0;
}

const jsonLd: Record<string, unknown> = localBusinessSchema({ description: SITE.description });
if (products.length > 0) {
  jsonLd.offers = products.slice(0, 3).map((p) => ({
    "@type": "Offer", name: p.name, description: p.description,
    price: p.price / 100, priceCurrency: p.currency,
    availability: "https://schema.org/InStock",
  }));
}
---
<BaseLayout
  title={`${SITE.name} — Minitortas y minidonas artesanales en Loja`}
  description={SITE.description}
  canonicalUrl="https://elhornodelpinguino.com"
  jsonLd={jsonLd}
>
  <main>
    <Hero />
    <AnnouncementBanner banners={content.banners} />
    <Marquee />
    <FlavourShowcase />
    <ErrorBoundary hasError={hasProductsError} message="No pudimos cargar los productos ahora. Escríbenos y te contamos lo que tenemos.">
      <ProductGrid products={products} />
    </ErrorBoundary>
    <Statement />
    <Trust />
    <HowToOrder />
    <FAQ faqs={faqs} />
    <BusinessBridge />
    <FinalCTA />
    <Contact />
  </main>
  <StickyWhatsApp />
</BaseLayout>
